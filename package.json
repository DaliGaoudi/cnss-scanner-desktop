{
  "name": "cnss-scanner-desktop",
  "version": "1.0.24",
  "private": true,
  "description": "Standalone CNSS بطاقة جبر scanner: scan/upload → AI extract → auto-record → Word act.",
  "author": "Office",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k -n client,electron \"npm:dev:client\" \"npm:dev:electron\"",
    "start": "electron .",
    "dist": "node scripts/prepare-wincodesign.js && npm run build:client && electron-builder",
    "release": "node scripts/release-version.js && node scripts/prepare-wincodesign.js && npm run build:client && electron-builder --publish always",
    "set-password": "node scripts/set-password.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "docxtemplater": "^3.68.7",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pizzip": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "tn.office.cnss.scanner",
    "productName": "CNSS Scanner",
    "publish": [
      {
        "provider": "github",
        "owner": "DaliGaoudi",
        "repo": "cnss-scanner-desktop",
        "releaseType": "release"
      }
    ],
    "files": [
      "electron/**",
      "server/**",
      "client/dist/**",
      "package.json",
      "!**/*.map",
      "!server/.userdata/**",
      "!server/assets/template_cnss.original.docx",
      "!server/assets/*.bak",
      "!server/assets/list_letterhead.source.docx"
    ],
    "extraResources": [
      {
        "from": "scan-watcher",
        "to": "scan-watcher"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CNSS Scanner"
    }
  }
}
